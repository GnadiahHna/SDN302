<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6fa; padding: 20px; }
        .container { background-color: #f4f6fa; padding: 20px; border-radius: 8px; }
        h2 { color: #1a73e8; font-weight: bold; text-align: center; margin-bottom: 20px; }
        .table { background-color: white; border-radius: 8px; overflow: hidden; }
        .table thead { background-color: #1a73e8; color: white; }
        .btn-update { background-color: #1a73e8; color: white; border: none; }
        .btn-delete { background-color: #f9a826; color: white; border: none; }
        .btn-create { background-color: #1a73e8; color: white; border: none; display: block; width: 200px; margin: 20px auto; }
    </style>
</head>
<body>
<div class="container mt-5">
    <h2>Product Orders</h2>
    <div class="table-responsive">
        <table class="table table-borderless align-middle">
            <thead>
                <tr>
                    <th>Customer Name</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Order Date</th>
                    <th></th>
                    <th>Total Price</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                <tr class="bg-white border-bottom">
                    <td><%= order.customerName %></td>
                    <td><%= order.productName %></td>
                    <td><%= order.quantity %></td>
                    <td><%= ("0" + (new Date(order.orderDate).getMonth() + 1)).slice(-2) %>/<%= ("0" + new Date(order.orderDate).getDate()).slice(-2) %>/<%= new Date(order.orderDate).getFullYear() %></td>
                    <td>
                        <a href="/orders/update/<%= order._id %>" class="btn btn-update btn-sm px-3">Update</a>
                        <a href="/orders/delete/<%= order._id %>" class="btn btn-delete btn-sm px-3 ms-1" onclick="return confirm('Are you sure?')">Delete</a>
                    </td>
                    <td><%= order.totalPrice %> VND</td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <a href="/orders/create" class="btn btn-create py-2 text-center text-decoration-none">Create New Order</a>
</div>
</body>
</html>
