<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Order</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f4f6fa; padding: 20px; }
        .form-container { background-color: white; padding: 30px; border-radius: 8px; max-width: 500px; margin: 0 auto; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
        h2 { color: #1a73e8; font-weight: bold; text-align: center; margin-bottom: 30px; }
        .form-label { color: #1a73e8; font-weight: 500; font-size: 0.9rem; }
        .btn-submit { background-color: #1a73e8; color: white; width: 100%; border: none; padding: 10px; margin-bottom: 10px; border-radius: 6px; }
        .btn-back { background-color: #f9a826; color: white; width: 100%; border: none; padding: 10px; border-radius: 6px; text-decoration: none; display: block; text-align: center; }
        .form-control, .form-select { border-color: #e0e0e0; border-radius: 6px; }
    </style>
</head>
<body>
<div class="container mt-5">
    <h2>Create New Order</h2>
    <div class="form-container">
        <form action="/orders/create" method="POST">
            <div class="mb-3">
                <label class="form-label">Customer Name</label>
                <input type="text" class="form-control" name="customerName" placeholder="Enter your name" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Product Name</label>
                <select class="form-select" name="productName" required>
                    <option value="" disabled selected>Enter product name</option>
                    <% products.forEach(p => { %>
                        <option value="<%= p.productName %>"><%= p.productName %></option>
                    <% }) %>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Quantity</label>
                <input type="number" class="form-control" name="quantity" placeholder="Enter quantity" required min="1">
            </div>
            <div class="mb-3">
                <label class="form-label">Order Date</label>
                <input type="date" class="form-control" name="orderDate" required>
            </div>
            <button type="submit" class="btn btn-submit">Place Order</button>
            <a href="/orders" class="btn btn-back">Go Back</a>
        </form>
    </div>
</div>
</body>
</html>
